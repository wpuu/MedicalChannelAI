# Server-only environment. Copy to /etc/medicalchannelai/pilot.env and chmod 600.
# Never commit the real API key.

# Required for the authenticated real Pilot. Must be the single public HTTPS
# origin serving both H5 and /api, with no path/query/fragment.
# Do not set this to the shared free qd.je Demo domain when real customer data is enabled.
MCAI_CANONICAL_ORIGIN=https://pilot.example.com

MCAI_AGNES_API_KEY=
# Optional. Leave empty to use the default allowlisted Agnes endpoint.
MCAI_AGNES_BASE_URL=
