{$MCAI_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8787
    }

    handle {
        root * /srv/medical/web
        try_files {path} /index.html
        file_server
    }
}
