{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-agnes-lease-decision.schema.json",
  "title": "Medical Agnes Lease Decision v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "task_id",
    "worker_id",
    "decided_at",
    "lease_id",
    "retry_after",
    "active_in_flight",
    "starts_last_60_seconds",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {
      "enum": [
        "GRANTED",
        "DEFERRED_NOT_BEFORE",
        "DEFERRED_DUPLICATE_ACTIVE",
        "DEFERRED_IN_FLIGHT",
        "DEFERRED_RPM",
        "DEFERRED_SPACING",
        "DEFERRED_CONTENTION"
      ]
    },
    "task_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "worker_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "decided_at": {"type": "string", "format": "date-time"},
    "lease_id": {"type": ["string", "null"], "pattern": "^agl_[0-9a-f]{64}$"},
    "retry_after": {"type": ["string", "null"], "format": "date-time"},
    "active_in_flight": {"type": "integer", "minimum": 0, "maximum": 20},
    "starts_last_60_seconds": {"type": "integer", "minimum": 0, "maximum": 60},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
