{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-material-event.schema.json",
  "title": "Medical Material Opportunity Event v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "material_event_id",
    "opportunity_id",
    "event_type",
    "verification_status",
    "model_generated",
    "change_fields",
    "supporting_fact_ids",
    "source_event_ids",
    "detected_at",
    "official_effective_at",
    "official_effective_at_precision",
    "idempotency_key"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "material_event_id": {"type": "string", "pattern": "^mevt_[0-9a-f]{64}$"},
    "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-fA-F-]{36}$"},
    "event_type": {"enum": ["NEW_VERIFIED_OPPORTUNITY", "LIFECYCLE_STATE_CHANGED", "DEADLINE_CHANGED", "AWARD_PUBLISHED"]},
    "verification_status": {"const": "VERIFIED"},
    "model_generated": {"const": false},
    "change_fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "supporting_fact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^fact_[0-9a-fA-F-]{36}$"},
      "uniqueItems": true
    },
    "source_event_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 240},
      "uniqueItems": true
    },
    "detected_at": {"type": "string", "format": "date-time"},
    "official_effective_at": {"type": ["string", "null"], "format": "date-time"},
    "official_effective_at_precision": {"enum": ["DAY", "MINUTE", "SECOND", "UNKNOWN"]},
    "idempotency_key": {"type": "string", "pattern": "^mat_[0-9a-f]{64}$"}
  }
}
