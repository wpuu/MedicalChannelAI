{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-cross-stage-link-candidate.schema.json",
  "title": "Medical Cross-stage Link Candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "earlier_canonical_project_id",
    "later_canonical_project_id",
    "earlier_event_id",
    "later_event_id",
    "stage_pair",
    "reasons",
    "confidence",
    "status",
    "auto_merge_allowed"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "candidate_id": {"type": "string", "pattern": "^linkcand_[0-9a-fA-F-]{36}$"},
    "earlier_canonical_project_id": {"type": "string", "pattern": "^mprj_[0-9a-fA-F-]{36}$"},
    "later_canonical_project_id": {"type": "string", "pattern": "^mprj_[0-9a-fA-F-]{36}$"},
    "earlier_event_id": {"type": "string", "pattern": "^evt_[0-9a-fA-F-]{36}$"},
    "later_event_id": {"type": "string", "pattern": "^evt_[0-9a-fA-F-]{36}$"},
    "stage_pair": {
      "type": "array",
      "prefixItems": [
        {"enum": ["PROCUREMENT_INTENT", "MARKET_RESEARCH", "INTERNAL_SELECTION"]},
        {"const": "TENDER"}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "BOTH_RECORDS_VERIFIED",
          "ALLOWED_STAGE_TRANSITION",
          "EXACT_NORMALIZED_BUYER",
          "EXACT_NORMALIZED_PROJECT_TITLE",
          "FORWARD_PUBLICATION_CHRONOLOGY"
        ]
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Heuristic candidate score only; not a calibrated probability and never sufficient for canonical merge."
    },
    "status": {"const": "CANDIDATE_REQUIRES_EVIDENCE"},
    "auto_merge_allowed": {"const": false}
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "earlier_canonical_project_id": {"const": ""},
          "later_canonical_project_id": {"const": ""}
        }
      }
    }
  ]
}
