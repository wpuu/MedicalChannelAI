{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-agnes-global-lease-state.schema.json",
  "title": "Medical Agnes Global Lease State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "revision",
    "recent_start_timestamps",
    "active_leases",
    "last_start_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "provider": {"const": "AGNES"},
    "model": {"const": "agnes-2.5-flash"},
    "revision": {"type": "integer", "minimum": 0},
    "recent_start_timestamps": {
      "type": "array",
      "maxItems": 60,
      "items": {"type": "string", "format": "date-time"}
    },
    "active_leases": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lease_id", "task_id", "worker_id", "acquired_at", "expires_at"],
        "properties": {
          "lease_id": {"type": "string", "pattern": "^agl_[0-9a-f]{64}$"},
          "task_id": {"type": "string", "minLength": 1, "maxLength": 240},
          "worker_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "acquired_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "last_start_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
