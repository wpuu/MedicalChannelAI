{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-institution-evidence.schema.json",
  "title": "Medical Institution Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "institution_id",
    "canonical_name",
    "aliases",
    "institution_type",
    "hospital_grade",
    "match_customer_type",
    "region",
    "evidence",
    "verification_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "institution_id": {"type": "string", "pattern": "^inst_[a-z0-9_]{3,100}$"},
    "canonical_name": {"type": "string", "minLength": 1, "maxLength": 300},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 300}, "uniqueItems": true},
    "institution_type": {"enum": ["HOSPITAL", "CDC", "BLOOD_CENTER", "UNIVERSITY", "RESEARCH_INSTITUTE", "THIRD_PARTY_LAB", "OTHER"]},
    "hospital_grade": {"type": ["string", "null"], "enum": ["TERTIARY_A", "TERTIARY", "SECONDARY_A", "SECONDARY", "PRIMARY", "UNKNOWN", null]},
    "match_customer_type": {"enum": ["TERTIARY_HOSPITAL", "SECONDARY_HOSPITAL", "PRIMARY_CARE", "PRIVATE_HOSPITAL", "CDC", "BLOOD_CENTER", "UNIVERSITY", "RESEARCH_INSTITUTE", "THIRD_PARTY_LAB", "OTHER"]},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["province", "city", "district"],
      "properties": {
        "province": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "district": {"type": ["string", "null"]}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url", "source_authority", "claim_type", "claim_value", "verification_status"],
        "properties": {
          "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "source_authority": {"enum": ["OFFICIAL_GOVERNMENT", "OFFICIAL_HOSPITAL", "OFFICIAL_INSTITUTION"]},
          "claim_type": {"enum": ["INSTITUTION_TYPE", "HOSPITAL_GRADE", "PUBLIC_OWNERSHIP", "REGION"]},
          "claim_value": {"type": "string", "minLength": 1, "maxLength": 500},
          "verification_status": {"const": "VERIFIED"}
        }
      }
    },
    "verification_status": {"const": "VERIFIED"}
  }
}
