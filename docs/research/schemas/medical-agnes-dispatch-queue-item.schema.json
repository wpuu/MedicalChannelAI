{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-agnes-dispatch-queue-item.schema.json",
  "title": "Medical Agnes Dispatch Queue Item v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "source",
    "profile_id",
    "opportunity_id",
    "model_input_sha256",
    "model_input",
    "dispatch_item",
    "enqueued_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 300},
    "source": {"const": "TODAY_ACTIONS"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-fA-F-]{36}$"},
    "model_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_input": {"type": "object"},
    "dispatch_item": {"type": "object"},
    "enqueued_at": {"type": "string", "format": "date-time"}
  }
}
