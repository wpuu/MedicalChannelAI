{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-followed-opportunities-public.schema.json",
  "title": "Medical Followed Opportunities Public View v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "count", "items"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "mode": {"const": "FOLLOWED_OPPORTUNITIES"},
    "count": {"type": "integer", "minimum": 0, "maximum": 100},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity_id",
          "followup_status",
          "remind_at",
          "latest_note",
          "followup_updated_at",
          "facts",
          "evidence_source_urls"
        ],
        "properties": {
          "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-fA-F-]{36}$"},
          "followup_status": {
            "enum": [
              "NEW",
              "REVIEWING",
              "CONTACTED",
              "RELATIONSHIP_VERIFIED",
              "PREPARING",
              "BID_SUBMITTED",
              "WON",
              "LOST",
              "NOT_FIT",
              "MONITOR"
            ]
          },
          "remind_at": {"type": ["string", "null"], "format": "date-time"},
          "latest_note": {"type": ["string", "null"], "maxLength": 4000},
          "followup_updated_at": {"type": "string", "format": "date-time"},
          "facts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project_number",
              "project_name",
              "buyer_name",
              "hospital_name",
              "department",
              "lifecycle_state",
              "published_at",
              "bid_deadline",
              "expected_procurement_at",
              "budget_cny"
            ],
            "properties": {
              "project_number": {"type": ["string", "null"], "maxLength": 500},
              "project_name": {"type": ["string", "null"], "maxLength": 1000},
              "buyer_name": {"type": ["string", "null"], "maxLength": 500},
              "hospital_name": {"type": ["string", "null"], "maxLength": 500},
              "department": {"type": ["string", "null"], "maxLength": 500},
              "lifecycle_state": {"type": ["string", "null"], "maxLength": 80},
              "published_at": {"type": ["string", "null"], "maxLength": 80},
              "bid_deadline": {"type": ["string", "null"], "maxLength": 80},
              "expected_procurement_at": {"type": ["string", "null"], "maxLength": 80},
              "budget_cny": {"type": ["number", "null"], "minimum": 0}
            }
          },
          "evidence_source_urls": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "format": "uri"}
          }
        }
      }
    }
  }
}
