{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/medical-opportunity.schema.json",
  "title": "Medical Opportunity v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "opportunity_id",
    "canonical_project_id",
    "buyer_name",
    "region",
    "project_name",
    "lifecycle_state",
    "verification_status",
    "coverage_status",
    "source_event_ids",
    "current_event_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-fA-F-]{36}$"},
    "canonical_project_id": {"type": "string", "pattern": "^mprj_[0-9a-fA-F-]{36}$"},
    "project_number": {"type": ["string", "null"], "maxLength": 160},
    "buyer_name": {"type": "string", "minLength": 1, "maxLength": 300},
    "buyer_type": {
      "enum": ["HOSPITAL", "CDC", "BLOOD_CENTER", "UNIVERSITY", "RESEARCH_INSTITUTE", "HEALTH_AUTHORITY", "OTHER"]
    },
    "hospital_name": {"type": ["string", "null"], "maxLength": 300},
    "department": {"type": ["string", "null"], "maxLength": 200},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "province", "city"],
      "properties": {
        "country": {"type": "string", "minLength": 2},
        "province": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "district": {"type": ["string", "null"]}
      }
    },
    "project_name": {"type": "string", "minLength": 1, "maxLength": 500},
    "notice_type": {
      "enum": ["MARKET_RESEARCH", "PROCUREMENT_INTENT", "TENDER", "AMENDMENT", "SUSPENSION", "TERMINATION", "AWARD", "CONTRACT", "INTERNAL_SELECTION", "OTHER"]
    },
    "lifecycle_state": {
      "enum": ["MARKET_RESEARCH", "PROCUREMENT_INTENT", "PREPARING", "TENDERING", "AMENDED", "BID_CLOSED", "SUSPENDED", "TERMINATED", "AWARDED", "CONTRACTED", "CLOSED", "UNKNOWN"]
    },
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "published_at_precision": {
      "type": ["string", "null"],
      "enum": ["DAY", "MINUTE", "SECOND", "UNKNOWN", null]
    },
    "registration_deadline": {"type": ["string", "null"], "format": "date-time"},
    "bid_deadline": {"type": ["string", "null"], "format": "date-time"},
    "expected_procurement_at": {
      "type": ["string", "null"],
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])(-([0-2][0-9]|3[0-1]))?$"
    },
    "expected_procurement_precision": {
      "type": ["string", "null"],
      "enum": ["MONTH", "DAY", null]
    },
    "budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
        "currency": {"const": "CNY"}
      }
    },
    "procurement_method": {"type": ["string", "null"], "maxLength": 120},
    "product_categories": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 160},
      "uniqueItems": true,
      "default": []
    },
    "product_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_name", "fact_ids"],
        "properties": {
          "raw_name": {"type": "string", "minLength": 1, "maxLength": 300},
          "normalized_name": {"type": ["string", "null"], "maxLength": 300},
          "category_l1": {"type": ["string", "null"]},
          "category_l2": {"type": ["string", "null"]},
          "category_l3": {"type": ["string", "null"]},
          "quantity": {"type": ["string", "null"], "maxLength": 80},
          "unit": {"type": ["string", "null"], "maxLength": 80},
          "brand_if_officially_stated": {"type": ["string", "null"], "maxLength": 200},
          "model_if_officially_stated": {"type": ["string", "null"], "maxLength": 200},
          "fact_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^fact_[0-9a-fA-F-]{36}$"},
            "uniqueItems": true
          }
        }
      },
      "default": []
    },
    "public_contact": {"type": ["string", "null"], "maxLength": 500},
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^evt_[0-9a-fA-F-]{36}$"},
      "uniqueItems": true
    },
    "current_event_id": {"type": "string", "pattern": "^evt_[0-9a-fA-F-]{36}$"},
    "verification_status": {
      "enum": ["UNVERIFIED", "VERIFIED", "CONFLICTED", "SUPERSEDED", "SOURCE_UNAVAILABLE"]
    },
    "coverage_status": {"enum": ["CURRENT", "PARTIAL", "DEGRADED", "UNKNOWN"]},
    "last_full_refresh_at": {"type": ["string", "null"], "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
