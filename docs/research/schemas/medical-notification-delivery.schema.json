{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicalchannelai.local/schemas/medical-notification-delivery.schema.json",
  "title": "Medical Notification Delivery v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notification_id",
    "idempotency_key",
    "subscription_dedupe_key",
    "profile_id",
    "opportunity_id",
    "material_event_id",
    "channel",
    "audience",
    "target_owner",
    "status",
    "attempt_count",
    "max_attempts",
    "queued_at",
    "sent_at",
    "delivered_at",
    "failed_at",
    "provider_message_id",
    "last_error_code"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "notification_id": {"type": "string", "pattern": "^notify_[0-9a-f]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^ndel_[0-9a-f]{64}$"},
    "subscription_dedupe_key": {"type": "string", "pattern": "^subeval_[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "pattern": "^mprof_[0-9a-fA-F-]{36}$"},
    "opportunity_id": {"type": "string", "pattern": "^opp_[0-9a-fA-F-]{36}$"},
    "material_event_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "channel": {"enum": ["WEB_INBOX", "WECHAT_MINI_PROGRAM", "MOBILE_PUSH"]},
    "audience": {"enum": ["OWNER", "TEAM_INBOX", "NONE"]},
    "target_owner": {"type": ["string", "null"], "maxLength": 200},
    "status": {"enum": ["QUEUED", "SENT", "DELIVERED", "FAILED", "SUPPRESSED"]},
    "attempt_count": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
    "queued_at": {"type": ["string", "null"], "format": "date-time"},
    "sent_at": {"type": ["string", "null"], "format": "date-time"},
    "delivered_at": {"type": ["string", "null"], "format": "date-time"},
    "failed_at": {"type": ["string", "null"], "format": "date-time"},
    "provider_message_id": {"type": ["string", "null"], "maxLength": 300},
    "last_error_code": {"type": ["string", "null"], "maxLength": 160}
  }
}
