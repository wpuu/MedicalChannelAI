{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "chatgpt/m1-evidence-pipeline-v1": true
    }
  },
  "functions": {
    "api/collector-run.py": {
      "maxDuration": 300
    },
    "api/pipeline-health.py": {
      "maxDuration": 60
    },
    "api/collector-status.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/collector-run?stage=ccgp",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/collector-run?stage=event1",
      "schedule": "35 0 * * *"
    },
    {
      "path": "/api/collector-run?stage=event2",
      "schedule": "50 0 * * *"
    },
    {
      "path": "/api/collector-run?stage=event3",
      "schedule": "5 1 * * *"
    },
    {
      "path": "/api/collector-run?stage=event4",
      "schedule": "20 1 * * *"
    },
    {
      "path": "/api/collector-run?stage=event5",
      "schedule": "35 1 * * *"
    },
    {
      "path": "/api/collector-run?stage=event6",
      "schedule": "50 1 * * *"
    },
    {
      "path": "/api/collector-run?stage=tjmugh",
      "schedule": "5 2 * * *"
    },
    {
      "path": "/api/collector-run?stage=tjnothop",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/collector-run?stage=publish",
      "schedule": "35 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
