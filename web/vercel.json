{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/tjmugh-verification-20261002": false,
      "fix/regional-bj-budget-20261003": false,
      "chatgpt/m1-evidence-pipeline-v1": true,
      "chatgpt/opportunity-ranking-v2-final": false
    }
  },
  "functions": {
    "api/ai/analyze.js": {
      "maxDuration": 60
    },
    "api/collector-run.py": {
      "maxDuration": 60
    },
    "api/collector-queue.py": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "medicalchannelai-refresh-v2",
          "retryAfterSeconds": 360,
          "maxConcurrency": 1,
          "maxDeliveries": 3,
          "initialDelaySeconds": 0
        }
      ]
    },
    "api/pipeline-health.py": {
      "maxDuration": 60
    },
    "api/collector-status.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/collector-run?period=morning",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/collector-run?period=noon",
      "schedule": "20 4 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/auth/register", "destination": "/api/auth?route=register" },
    { "source": "/api/auth/login", "destination": "/api/auth?route=login" },
    { "source": "/api/auth/logout", "destination": "/api/auth?route=logout" },
    { "source": "/api/auth/me", "destination": "/api/auth?route=me" },
    { "source": "/api/account/export", "destination": "/api/auth?route=export" },
    { "source": "/api/account/delete", "destination": "/api/auth?route=delete" },
    { "source": "/api/today", "destination": "/api/private?route=today" },
    { "source": "/api/opportunity-pool/today", "destination": "/api/private?route=today&include_pool=1" },
    { "source": "/api/opportunity/:id", "destination": "/api/private?route=opportunity&id=:id" },
    { "source": "/api/public-history/:id", "destination": "/api/profile?route=public-history&id=:id" },
    { "source": "/api/followup/:id", "destination": "/api/private?route=followup&id=:id" },
    { "source": "/api/followed", "destination": "/api/private?route=followed" },
    { "source": "/api/reminders", "destination": "/api/private?route=reminders" },
    { "source": "/api/reminders/:id/ack", "destination": "/api/private?route=reminder-ack&id=:id" },
    { "source": "/api/feedback/:id", "destination": "/api/private?route=feedback&id=:id" },
    { "source": "/api/ai/discover-continuation", "destination": "/api/ai/discover?route=continuation" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
